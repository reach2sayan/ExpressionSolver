@PACKAGE_INIT@

# This file serves an install prefix and a build tree alike, so it must resolve
# nothing by path: @PACKAGE_INIT@'s PACKAGE_PREFIX_DIR is computed for the
# install destination and is wrong in a build tree.  Anything that needs a
# location belongs on the exported targets, which carry the right one for each
# tree already through BUILD_INTERFACE/INSTALL_INTERFACE.
include(CMakeFindDependencyMacro)

# What the exported targets need found again on the consumer's machine.
set(DDX_BUILD_JIT @DDX_BUILD_JIT@)

# Boost::headers rather than any component: every Boost library ddx uses --
# Mp11 for the symbol lists, Graph and DynamicBitset for the runtime graph -- is
# header-only, so what a consumer needs is an include path.  The same find the
# build itself made, in config mode for the same reason (CMP0167: the module is
# deprecated since CMake 3.30 and removed in 4).  No version pinned: ddx checked
# at configure time that the headers it names are there, and a consumer's Boost
# has to answer for itself, so a release number here would only turn away Boosts
# that work.  Reported when it differs, because if it ever does matter the two
# versions are the first thing worth knowing.
find_dependency(Boost CONFIG)
# ddx_rt links Threads::Threads publicly: rt/equation.hpp compiles on another
# thread, so the target has to resolve in a consumer's tree too.
find_dependency(Threads)
if (NOT Boost_VERSION VERSION_EQUAL "@Boost_VERSION@")
    message(STATUS
            "ddx was built against Boost @Boost_VERSION@; this consumer resolved ${Boost_VERSION}.")
endif ()

if (DDX_BUILD_JIT)
    # Where this build found LLVM, so a machine with several does not need the
    # consumer to guess which one ddx::jit was compiled against.
    if (NOT DEFINED LLVM_DIR)
        set(LLVM_DIR "@LLVM_DIR@")
    endif ()
    # Unversioned, then checked by hand: LLVMConfig declares itself compatible
    # only with an exact version request, so find_dependency(LLVM 20) fails
    # against 20.1.2.
    find_dependency(LLVM CONFIG)
    # An exact major, not the @DDX_LLVM_VERSION_MIN@-@DDX_LLVM_VERSION_MAX@
    # range the sources build against: ddx::jit is a compiled artefact, and the
    # ORC C++ API it is compiled against is not stable across releases.  The
    # range is what ddx can be built with; this is what this one was.
    if (NOT LLVM_VERSION_MAJOR EQUAL @LLVM_VERSION_MAJOR@)
        message(FATAL_ERROR
                "ddx::jit was built against LLVM @LLVM_VERSION_MAJOR@; found ${LLVM_PACKAGE_VERSION}. "
                "Point CMake at the matching one with -DLLVM_DIR=<prefix>/lib/cmake/llvm.")
    endif ()
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/ddxTargets.cmake")

# ddx::jit is the same library as ddx::rt -- the backend is compiled into libddx
# rather than shipped beside it -- and an ALIAS is a build-tree thing that no
# export set carries.  An INTERFACE target that forwards to it is what survives
# into an installed package.
if (DDX_BUILD_JIT AND NOT TARGET ddx::jit)
    add_library(ddx::jit INTERFACE IMPORTED)
    set_target_properties(ddx::jit PROPERTIES INTERFACE_LINK_LIBRARIES ddx::rt)
endif ()

# How ddx itself was compiled.  Not pushed onto ddx::ddx -- an INTERFACE library
# must not force a flag on a consumer -- but a consumer whose numbers have to be
# comparable with ddx's own needs to be able to ask.  FP contraction is the one
# that changes results rather than speed: ddx::jit emits code contracting to
# match, so a consumer that differs here can compute different derivatives.
set(ddx_CODEGEN_FLAGS "@DDX_CODEGEN_FLAGS@")
set(ddx_FP_CONTRACT @DDX_FP_FLAGS@)

# Without these the check below is a no-op and a component request for a part
# that was never built succeeds, leaving the consumer to find out at link time.
set(ddx_ddx_FOUND TRUE)
set(ddx_util_FOUND TRUE)
set(ddx_ops_FOUND TRUE)
set(ddx_md_FOUND TRUE)
set(ddx_symbolic_FOUND TRUE)
# The runtime graph and forward mode are in every build; only the backend is not.
set(ddx_rt_FOUND TRUE)
set(ddx_dual_FOUND TRUE)
set(ddx_jit_FOUND ${DDX_BUILD_JIT})

# check_required_components() reports only that ddx_FOUND went false, which
# leaves the consumer to guess which component and how to get it.
set(DDX_jit_OPTION DDX_BUILD_JIT)
foreach (comp IN LISTS ddx_FIND_COMPONENTS)
    if (NOT ddx_${comp}_FOUND AND DEFINED DDX_${comp}_OPTION)
        set(ddx_NOT_FOUND_MESSAGE "this ddx was built without the '${comp}' \
component; reconfigure it with -D${DDX_${comp}_OPTION}=ON.")
    endif ()
endforeach ()

check_required_components(ddx)
