@PACKAGE_INIT@

# Generated once per tree -- DdxInstall configures this template twice -- so a
# path substituted in is already the right one and nothing here probes for it.
# What is shared between the two belongs on the exported targets, which carry
# the right location for each through BUILD_INTERFACE/INSTALL_INTERFACE.
include(CMakeFindDependencyMacro)

# Which parts this build has.  LLVM is not found again: libddx carries it, and
# a consumer's link never names it.
set(DDX_BUILD_JIT @DDX_BUILD_JIT@)

if (NOT TARGET Boost::headers)
    add_library(Boost::headers INTERFACE IMPORTED)
    set_target_properties(Boost::headers PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "@DDX_BOOST_CONFIG_ROOT@")
endif ()

find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/ddxTargets.cmake")

if (DDX_BUILD_JIT AND NOT TARGET ddx::jit)
    add_library(ddx::jit INTERFACE IMPORTED)
    set_target_properties(ddx::jit PROPERTIES INTERFACE_LINK_LIBRARIES ddx::rt)
endif ()

set(ddx_CODEGEN_FLAGS "@DDX_CODEGEN_FLAGS@")
set(ddx_FP_CONTRACT @DDX_FP_FLAGS@)

# Without these the check below is a no-op and a component request for a part
# that was never built succeeds, leaving the consumer to find out at link time.
set(ddx_ddx_FOUND TRUE)
set(ddx_util_FOUND TRUE)
set(ddx_ops_FOUND TRUE)
set(ddx_md_FOUND TRUE)
set(ddx_symbolic_FOUND TRUE)
# The runtime graph and forward mode are in every build; only the backend is not.
set(ddx_rt_FOUND TRUE)
set(ddx_dual_FOUND TRUE)
set(ddx_jit_FOUND ${DDX_BUILD_JIT})

# check_required_components() reports only that ddx_FOUND went false, which
# leaves the consumer to guess which component and how to get it.
set(DDX_jit_OPTION DDX_BUILD_JIT)
foreach (comp IN LISTS ddx_FIND_COMPONENTS)
    if (NOT ddx_${comp}_FOUND AND DEFINED DDX_${comp}_OPTION)
        set(ddx_NOT_FOUND_MESSAGE "this ddx was built without the '${comp}' \
component; reconfigure it with -D${DDX_${comp}_OPTION}=ON.")
    endif ()
endforeach ()

check_required_components(ddx)
