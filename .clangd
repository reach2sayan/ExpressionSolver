# DDX_DEDUCING_THIS=1 is forced here for the same reason CMake offers
# -DDDX_DEDUCING_THIS=on: clang implements P0847 from 18 but never defines
# __cpp_explicit_this_parameter, so a clangd running with clang semantics would
# take the fallback branch in include/util/config.hpp and grey out the deducing-this
# accessors even when the build compiles them.
CompileFlags:
  CompilationDatabase: cmake-build-debug
  Add: [-std=c++23, -I/usr/include, -DDDX_DEDUCING_THIS=1]
